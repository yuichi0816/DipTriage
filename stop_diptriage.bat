@echo off
echo Stopping DipTriage...
powershell -NoProfile -Command "$port=8000; $all=Get-WmiObject Win32_Process -ErrorAction SilentlyContinue; $kill=[System.Collections.Generic.HashSet[int]]::new(); $lpids=@((Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue).OwningProcess | Sort-Object -Unique); if(-not $lpids){Write-Host 'Not running on port 8000.';exit 0}; foreach($lp in $lpids){[void]$kill.Add($lp); $all | Where-Object {$_.ParentProcessId -eq $lp} | ForEach-Object {[void]$kill.Add($_.ProcessId)}}; $all | Where-Object {$_.Name -match 'python|uv' -and $_.CommandLine -match 'uvicorn'} | ForEach-Object {$u=$_.ProcessId;[void]$kill.Add($u);$all | Where-Object {$_.ParentProcessId -eq $u} | ForEach-Object {[void]$kill.Add($_.ProcessId)}}; foreach($k in $kill){Stop-Process -Id $k -Force -ErrorAction SilentlyContinue}; Start-Sleep -Milliseconds 800; if(Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue){Write-Host 'Warning: port still in use.'}else{Write-Host 'Stopped.'}"
pause
