# Database
DB_PATH=./data/diptriage.db

# Detection thresholds
THRESHOLD_DIP_PCT=-5.0
MACRO_FILTER_PCT=-2.0

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_INTERVIEW=qwen3.5:9b
OLLAMA_MODEL_DIAGNOSIS=qwen3.6:35b

# Pipeline schedule (cron, JST)
PIPELINE_HOUR=7
PIPELINE_MINUTE=0

# アクセス制御（DIPTRIAGE_PASSWORD を設定すると全ページに Basic 認証がかかる）
DIPTRIAGE_USER=diptriage
DIPTRIAGE_PASSWORD=
