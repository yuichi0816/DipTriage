# Database
# OneDrive 等の同期フォルダの外を推奨（ロック競合・破損防止。例: C:/Users/<you>/AppData/Local/DipTriage/diptriage.db）
DB_PATH=./data/diptriage.db

# Detection thresholds
THRESHOLD_DIP_PCT=-5.0
MACRO_FILTER_PCT=-2.0

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_INTERVIEW=qwen3.5:9b
OLLAMA_MODEL_DIAGNOSIS=qwen3.6:35b

# Pipeline schedule (cron, JST)
PIPELINE_HOUR=7
PIPELINE_MINUTE=0

# アクセス制御（DIPTRIAGE_PASSWORD を設定すると全ページに Basic 認証がかかる）
DIPTRIAGE_USER=diptriage
DIPTRIAGE_PASSWORD=

# Groq API キー（設定すると設定画面で保存した DB 内のキーより優先される。.env 管理を推奨）
GROQ_API_KEY=
